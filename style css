/* =========================================================================
   ETSY / PRODUCT SELLER STOREFRONT TEMPLATE
   Palette: kiln red / gold / warm dark — a "maker's swatch table" aesthetic
   ========================================================================= */

:root {
    --ink: #1C1815;
    --card: #241F1B;
    --card-raised: #2C261F;
    --kiln: #E8735A;
    --kiln-hover: #D65E44;
    --gold: #D4A73D;
    --paper: #F5EFE8;
    --muted: #B8AA9C;
    --line: #38312A;
    --radius: 16px;
}

* { box-sizing: border-box; }

body {
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
}

h1, h2, .brand, .swatch-title {
    font-family: 'Bricolage Grotesque', -apple-system, sans-serif;
    font-weight: 700;
    color: var(--paper);
    margin: 0;
}

.mono, .sku { font-family: 'IBM Plex Mono', monospace; }

.wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
}

a { color: inherit; }

/* --- Header --- */
.site-header {
    position: sticky;
    top: 0;
    background: rgba(28, 24, 21, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    z-index: 10;
}

.header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
}

.brand { font-size: 1.3rem; }

.nav { display: flex; gap: 2rem; }
.nav a {
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.2s ease;
}
.nav a:hover { color: var(--paper); }

/* --- Buttons --- */
.btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.9rem 1.7rem;
    transition: background-color 0.2s ease, transform 0.1s ease;
}
.btn-kiln { background: var(--kiln); color: #FFF8F5; }
.btn-kiln:hover { background: var(--kiln-hover); }
.btn-kiln:active { transform: scale(0.98); }
.btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.btn-small { padding: 0.65rem 1.3rem; font-size: 0.9rem; }
.btn-wide { display: block; text-align: center; width: 100%; }

/* --- Hero --- */
.hero { padding: 5.5rem 0 4rem; }
.hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
}
.eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 0.75rem;
}
.eyebrow.center, h2.center { text-align: center; }
h1 { font-size: clamp(2.3rem, 4.2vw, 3.3rem); line-height: 1.12; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
.hero-sub { color: var(--muted); font-size: 1.05rem; margin-bottom: 2rem; max-width: 46ch; }

/* Signature element: the swatch strip */
.swatch-panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.85rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
}
.swatch-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.9rem;
    margin-bottom: 1.4rem;
}
.swatch-title { font-size: 1.05rem; }
.swatch-sub { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.swatch-strip { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
.swatch-dot {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: transform 0.15s ease, border-color 0.15s ease;
    position: relative;
}
.swatch-dot:hover { transform: translateY(-3px); }
.swatch-dot.is-active { border-color: var(--gold); }
.swatch-dot.is-active::after {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    opacity: 0.5;
}
.swatch-active { font-size: 0.85rem; color: var(--muted); margin: 0; }
.swatch-active strong { color: var(--paper); }

/* --- Trust strip --- */
.trust-strip { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.5rem 0; }
.trust-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* --- Categories --- */
.categories { padding: 5rem 0; }
.categories h2 { margin: 0.5rem 0 3rem; font-size: 2rem; }
.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.category-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
}
.category-card:hover { transform: translateY(-4px); border-color: var(--kiln); }
.category-icon {
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1rem; font-size: 1.4rem;
    background: var(--card-raised);
}
.category-name { font-weight: 700; margin-bottom: 0.4rem; }
.category-count { font-size: 0.85rem; color: var(--muted); }

/* --- Products --- */
.products { padding: 5rem 0; background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.products h2 { margin: 0.5rem 0 3rem; font-size: 2rem; }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
.product-card {
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
}
.product-image {
    aspect-ratio: 1;
    background: var(--card-raised);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 0.85rem;
}
.product-body { padding: 1.4rem; }
.product-name { font-weight: 700; margin-bottom: 0.3rem; }
.product-price { font-family: 'IBM Plex Mono', monospace; color: var(--gold); font-weight: 500; margin-bottom: 0.9rem; }
.product-swatches { display: flex; gap: 0.4rem; }
.mini-dot { width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.15); }

/* --- About --- */
.about { padding: 5rem 0; }
.about-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 3rem; align-items: center; }
.about-photo {
    aspect-ratio: 4 / 5;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
}
.photo-label { color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
.about-copy h2 { margin-bottom: 1rem; font-size: 2rem; }
.about-copy p { color: var(--muted); }
.about-facts { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-direction: column; gap: 0.6rem; }
.about-facts li {
    padding-left: 1.4rem;
    position: relative;
    font-size: 0.95rem;
}
.about-facts li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--kiln);
}

/* --- Reviews --- */
.reviews { padding: 5rem 0; background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.reviews h2 { margin: 0.5rem 0 3rem; font-size: 2rem; }
.review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.review-card {
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
}
.review-stars { color: var(--gold); font-size: 0.9rem; margin-bottom: 0.75rem; }
.review-quote { font-size: 0.98rem; margin: 0 0 1rem; }
.review-name { font-size: 0.85rem; color: var(--gold); font-weight: 700; }

/* --- CTA --- */
.cta { padding: 5rem 0 6rem; }
.cta-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
.cta-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
}
.cta-note { color: var(--muted); font-size: 0.9rem; margin: 0.5rem 0 1.5rem; }

/* --- Footer --- */
.site-footer { border-top: 1px solid var(--line); padding: 2rem 0; }
.footer-row { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--muted); }

/* --- Scroll reveal --- */
.reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
.reveal.is-visible { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
}

/* --- Responsive --- */
@media (max-width: 860px) {
    .hero-grid, .about-grid, .cta-inner { grid-template-columns: 1fr; }
    .about-photo { max-width: 320px; }
    .category-grid, .product-grid, .review-grid { grid-template-columns: 1fr; }
    .nav { display: none; }
}
@media (max-width: 600px) and (min-width: 861px) {
    /* unreachable, safety */
}
@media (min-width: 481px) and (max-width: 860px) {
    .category-grid, .product-grid, .review-grid { grid-template-columns: repeat(2, 1fr); }
}
